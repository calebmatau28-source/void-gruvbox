#!/usr/bin/env bash

set -u

WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-picker"
THUMB_DIR="$STATE_DIR/thumbnails"
STATE_FILE="$STATE_DIR/current"
DEFAULT_WALLPAPER="$HOME/Downloads/wallhaven-lydkg2_1280x800.png"

mkdir -p "$WALLPAPER_DIR" "$STATE_DIR" "$THUMB_DIR"

for cmd in rofi swaybg find sort; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Missing dependency: $cmd" >&2
    exit 1
  fi
done

if [[ "${1:-}" == "--restore" ]]; then
  if [[ -r "$STATE_FILE" ]]; then
    wallpaper="$(<"$STATE_FILE")"
  else
    wallpaper="$DEFAULT_WALLPAPER"
  fi
else
  # Search all folders recursively.
  mapfile -d '' -t files < <(
    find "$WALLPAPER_DIR" -type f \
      \( -iname '*.png' \
      -o -iname '*.jpg' \
      -o -iname '*.jpeg' \
      -o -iname '*.webp' \
      -o -iname '*.bmp' \) \
      -print0 | sort -z
  )

  if ((${#files[@]} == 0)); then
    rofi -e "Add wallpapers to ~/Pictures/Wallpapers"
    exit 0
  fi

  choice=$(
    for file in "${files[@]}"; do
      # Preserve the relative folder path.
      relative_path="${file#"$WALLPAPER_DIR"/}"

      # Separate cache path for each folder.
      thumb="$THUMB_DIR/$relative_path.png"

      mkdir -p "$(dirname "$thumb")"

      # Generate or refresh cached thumbnail.
      if command -v magick >/dev/null 2>&1; then
        if [[ ! -f "$thumb" || "$file" -nt "$thumb" ]]; then
          magick "$file" \
            -auto-orient \
            -thumbnail '480x270^' \
            -gravity center \
            -extent 480x270 \
            "$thumb" || rm -f "$thumb"
        fi
      fi

      # Use thumbnail when available.
      if [[ -f "$thumb" ]]; then
        icon_path="$thumb"
      else
        icon_path="$file"
      fi

      # Display folder/name, but retain original image path.
      printf '%s\0icon\x1f%s\n' \
        "$relative_path" "$icon_path"
    done |
      rofi -dmenu -i -show-icons \
        -p " Wallpaper" \
        -no-custom \
        -theme "$HOME/.config/rofi/themes/wallpaper-picker.rasi"
  ) || exit 0

  [[ -n "$choice" ]] || exit 0

  # Resolve selected relative path to original wallpaper.
  wallpaper="$WALLPAPER_DIR/$choice"
fi

if [[ ! -f "$wallpaper" ]]; then
  echo "Wallpaper not found: $wallpaper" >&2
  exit 1
fi

printf '%s\n' "$wallpaper" >"$STATE_FILE"

if command -v matugen >/dev/null 2>&1; then
  matugen image "$wallpaper" --config "$HOME/.config/matugen/config.toml" --type scheme-fidelity --mode dark ||
    echo "Matugen color generation failed." >&2
fi

pkill -x swaybg 2>/dev/null || true

nohup swaybg -i "$wallpaper" -m fill \
  >/dev/null 2>&1 </dev/null &

exit 0
