# No default greeting
set -g fish_greeting

# Gruvbox-compatible ANSI colors
# Kitty's ANSI palette is generated by Matugen.
set -g fish_color_normal normal
set -g fish_color_command brgreen
set -g fish_color_param brblue
set -g fish_color_quote bryellow
set -g fish_color_error brred
set -g fish_color_comment brblack
set -g fish_color_operator brcyan
set -g fish_color_autosuggestion brblack
set -g fish_color_selection --background=brblack
set -g fish_color_search_match --background=brblack

# Add personal scripts to PATH
fish_add_path --prepend ~/.local/bin

# Useful abbreviations
if status is-interactive
    abbr --add ll 'ls -lah'
    abbr --add la 'ls -A'
    abbr --add update 'sudo xbps-install -Su'
    abbr --add search 'xbps-query -Rs'
    abbr --add v nvim
    abbr --add conf 'nvim ~/.config/fish/config.fish'
end

# Custom prompt
function fish_prompt
    set -l last_status $status

    set_color brgreen
    printf '%s' (whoami)

    set_color brblack
    printf '@'

    set_color brcyan
    printf '%s' (prompt_hostname)

    set_color normal
    printf ' '

    set_color brblue
    printf '%s' (prompt_pwd)

    set_color normal
    fish_vcs_prompt

    if test $last_status -eq 0
        set_color brgreen
    else
        set_color brred
    end

    printf ' ❯ '
    set_color normal
end

starship init fish | source

fish_add_path /home/hollow/.spicetify
# Modern CLI shortcuts
abbr -a ls 'eza --icons=auto'
abbr -a ll 'eza -lah --icons=auto'
abbr -a la 'eza -a --icons=auto'
abbr -a lg lazygit

# FZF search defaults
set -gx FZF_DEFAULT_COMMAND 'fd --type f --hidden --exclude .git'
set -gx FZF_CTRL_T_COMMAND "$FZF_DEFAULT_COMMAND"
